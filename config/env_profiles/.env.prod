# Ubuntu production behavior. Keep credentials in
# /etc/thinkorswim_bot/thinkorswim_bot.secrets.env.

BOT_ENV=prod
TIMEZONE=America/Los_Angeles
RUN_TASKS=True
LIVE_OPENING_ORDERS_ENABLED=False
MAX_LIVE_SESSION_OPEN_NOTIONAL=1000
BUY_PRICE=askPrice
SELL_PRICE=bidPrice
TAKE_PROFIT_PERCENTAGE=1.06
STOP_LOSS_PERCENTAGE=0.97
DEFAULT_STRATEGY_SETTINGS='{"FixedPercentageExit":{"take_profit_percentage":0.06,"stop_loss_percentage":0.03},"TrailingStopExit":{"trailing_stop_percentage":0.03}}'

BOT_APP_DIR=/opt/thinkorswim_bot/current
BOT_SHARED_DIR=/opt/thinkorswim_bot/shared
BOT_PYTHON_BIN=/opt/thinkorswim_bot/shared/.venv/bin/python
SCHWAB_TOKEN_PATH=/opt/orfa_bot/shared/secrets/schwab_token.json
GMAIL_TOKEN_PATH=/opt/thinkorswim_bot/shared/secrets/gmail_token.json
GMAIL_CREDENTIALS_PATH=/opt/thinkorswim_bot/shared/secrets/gmail_credentials.json
STOP_SIGNAL_FILE=/opt/thinkorswim_bot/shared/run/stop_signal.txt
NO_TRADE_DATES_FILE=/opt/thinkorswim_bot/current/config/no_trade_dates.txt
