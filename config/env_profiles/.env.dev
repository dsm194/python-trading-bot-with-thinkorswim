# Local development behavior. Keep credentials in config.secrets.env.

BOT_ENV=dev
TIMEZONE=America/Los_Angeles
RUN_TASKS=True
LOG_TO_CONSOLE=True
LIVE_ORDER_SUBMISSION_ENABLED=False
LIVE_OPENING_ORDERS_ENABLED=False
MAX_LIVE_SESSION_OPEN_NOTIONAL=1000
BUY_PRICE=askPrice
SELL_PRICE=bidPrice
TAKE_PROFIT_PERCENTAGE=1.06
STOP_LOSS_PERCENTAGE=0.97
DEFAULT_STRATEGY_SETTINGS='{"FixedPercentageExit":{"take_profit_percentage":0.06,"stop_loss_percentage":0.03},"TrailingStopExit":{"trailing_stop_percentage":0.03}}'

GMAIL_TOKEN_PATH=gmail/creds/token.json
GMAIL_CREDENTIALS_PATH=gmail/creds/credentials.json
STOP_SIGNAL_FILE=tmp/stop_signal.txt
NO_TRADE_DATES_FILE=config/no_trade_dates.txt
